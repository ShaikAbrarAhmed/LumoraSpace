# Production runs on Cloudflare Workers (wrangler.jsonc). Set each value below there with
#   npx wrangler secret put <NAME>
# NEXTAUTH_URL is already set in wrangler.jsonc. For a local Worker preview put values in .dev.vars.

# Site
# The public URL (https://www.lumoraspace.in) is fixed in src/lib/site.ts and is not read from
# the environment. Remove any NEXT_PUBLIC_APP_URL left in the hosting provider's settings.

# Authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=a_random_secret_string

# Email Notifications (Resend)
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=your_email@gmail.com

# Database (Firebase)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate limiting (Upstash Redis)
# Shared counters for the sign-in, sign-up and form limits. Without them each server instance
# counts on its own in memory, so on serverless hosts the limits are not enforced across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number of reverse proxies in front of the app that append the client address to
# X-Forwarded-For (for example 1 behind a single nginx). Ignored on Vercel, which sets the
# client address itself. Leave at 0 when unsure: the header is then not trusted and all
# clients share one rate-limit bucket.
TRUSTED_PROXY_HOPS=0
